# Dede configuration (copy to .env for docker compose)

DEDE_MODEL=qwen3-coder:30b
DEDE_DEVICE=auto
DEDE_MAX_FILE_SIZE_MB=5
DEDE_LLM_MAX_CONTEXT=32768
DEDE_OLLAMA_HOST=http://ollama:11434
# Strict mode: refuse missing-model downloads during scans.
DEDE_OFFLINE=false

# Analyzer / performance limits
ANALYZER_TIMEOUT_SECONDS=300
MAX_FILES=50000
MAX_LLM_FINDINGS=200
LLM_CONCURRENCY=2

# Scan target / report output (Makefile defaults OUTPUT to /tmp/<project-name>)
TARGET=.
# OUTPUT=/tmp/myproject

# Disable Semgrep telemetry
SEMGREP_SEND_METRICS=off
SEMGREP_ENABLE_VERSION_CHECK=0
DO_NOT_TRACK=1
