{
  "schema": 1,
  "rules": [
    {
      "id": "dede.any.secrets.jwt-token-literal",
      "message": "JWT token literal hardcoded in source; compromised tokens cannot be revoked without a code change.",
      "severity": "HIGH",
      "category": "secret",
      "languages": [
        "*"
      ],
      "when": [
        {
          "regex": "(?i)(jwt|token|auth|bearer)[^=]*[:=][^a-z0-9]?['\"]?eyJ[a-zA-Z0-9_-]{10,}\\.[a-zA-Z0-9_-]{10,}\\.[a-zA-Z0-9_-]{10,}['\"]?",
          "same_line": true,
          "not_regex": "(?i)(?:process\\.env|os\\.environ|getenv|example|test|placeholder|<)"
        }
      ],
      "confidence": "HIGH",
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2025"
      ],
      "asvs": [
        "v5.0.0-6.4.1"
      ],
      "recommendation": "Remove the token from source; load JWT tokens from environment variables or a secrets manager at runtime.",
      "references": [
        "https://cwe.mitre.org/data/definitions/798.html"
      ]
    },
    {
      "id": "dede.any.secrets.gcp-service-account-key",
      "message": "Google Cloud Platform service account private key JSON committed to source.",
      "severity": "CRITICAL",
      "category": "secret",
      "languages": [
        "*"
      ],
      "when": [
        {
          "regex": "\"private_key_id\"\\s*:",
          "same_line": true
        }
      ],
      "if": [
        {
          "contains_all": [
            "\"type\": \"service_account\"",
            "\"private_key\""
          ]
        }
      ],
      "confidence": "HIGH",
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2025"
      ],
      "asvs": [
        "v5.0.0-6.4.1"
      ],
      "recommendation": "Revoke the key immediately; use Workload Identity or inject credentials via Secret Manager.",
      "references": [
        "https://cwe.mitre.org/data/definitions/798.html",
        "https://cloud.google.com/iam/docs/best-practices-for-managing-service-account-keys"
      ]
    },
    {
      "id": "dede.any.secrets.azure-storage-key",
      "message": "Azure Storage account key committed in source.",
      "severity": "CRITICAL",
      "category": "secret",
      "languages": [
        "*"
      ],
      "when": [
        {
          "regex": "AccountKey=[a-zA-Z0-9+/]{40,}={0,2}",
          "same_line": true,
          "not_regex": "(?i)(?:example|your_key|changeme|<AccountKey>|\\$\\{)"
        }
      ],
      "confidence": "HIGH",
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2025"
      ],
      "asvs": [
        "v5.0.0-6.4.1"
      ],
      "recommendation": "Rotate the storage key; use Managed Identity or Azure Key Vault instead of embedding keys.",
      "references": [
        "https://cwe.mitre.org/data/definitions/798.html",
        "https://docs.microsoft.com/en-us/azure/storage/common/storage-account-keys-manage"
      ]
    },
    {
      "id": "dede.any.secrets.azure-tenant-client-secret",
      "message": "Azure client secret or tenant ID pattern found in source.",
      "severity": "HIGH",
      "category": "secret",
      "languages": [
        "*"
      ],
      "when": [
        {
          "regex": "(?i)(client[_-]?secret|tenant[_-]?id|application[_-]?id)\\s*[:=]\\s*['\"][0-9a-fA-F\\-]{36,}['\"]",
          "same_line": true,
          "not_regex": "(?i)(?:process\\.env|os\\.environ|getenv|example|your\\-|<|\\$\\{|xxxxxxxx)"
        }
      ],
      "confidence": "MEDIUM",
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2025"
      ],
      "asvs": [
        "v5.0.0-6.4.1"
      ],
      "recommendation": "Store Azure credentials in Key Vault or environment variables; rotate exposed secrets.",
      "references": [
        "https://cwe.mitre.org/data/definitions/798.html"
      ]
    },
