    {
      "id": "dede.py.tls.verify-disabled",
      "message": "TLS certificate verification is explicitly disabled.",
      "severity": "HIGH",
      "category": "security",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "(?i)\\b(?:requests|httpx)\\.(?:get|post|put|patch|delete|request)\\s*\\([^\\n]*\\bverify\\s*=\\s*false\\b",
          "same_line": true
        }
      ],
      "confidence": "HIGH",
      "cwe": [
        "CWE-295"
      ],
      "owasp": [
        "A02:2025"
      ],
      "recommendation": "Keep TLS certificate verification enabled and trust a specific CA bundle.",
      "exclude_comments": true
    },
    {
      "id": "dede.py.tls.unverified-context",
      "message": "Python SSL peer verification is disabled.",
      "severity": "HIGH",
      "category": "security",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "\\b(?:ssl\\.)?(?:CERT_NONE|_create_unverified_context)\\b",
