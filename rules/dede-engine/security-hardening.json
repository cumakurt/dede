      "confidence": "HIGH",
      "cwe": [
        "CWE-295"
      ],
      "owasp": [
        "A02:2025"
      ],
      "recommendation": "Use ssl.create_default_context() with certificate and hostname verification.",
      "exclude_comments": true
    },
