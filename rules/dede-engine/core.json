    {
      "id": "dede.py.secrets.hardcoded-credential",
      "message": "Possible hardcoded credential assigned to a secret-looking variable.",
      "severity": "HIGH",
      "category": "security",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "(?i)^\\s*(?:[a-z_]\\w*\\.)?[a-z_]*(?:password|passwd|secret|api_key|apikey|auth_token|access_token|private_key)[a-z_]*(?:\\s*:\\s*[^=]+)?\\s*=\\s*(?:[rub]{0,2})?[\"'][^\"'\\r\\n]{4,}[\"']",
          "same_line": true
        }
      ],
      "confidence": "MEDIUM",
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2025"
      ],
      "asvs": [
        "v5.0.0-6.4.1"
      ],
      "recommendation": "Load secrets from environment variables or a secret manager; never commit literal credentials.",
      "references": [
        "https://cwe.mitre.org/data/definitions/798.html",
        "https://owasp.org/Top10/2025/"
      ],
      "exclude_comments": true
    },
    {
