    {
      "id": "dede.native.jvm.ecb",
      "message": "Jvm ecb requires review.",
      "languages": [
        "java",
        "kotlin",
        "scala",
        "groovy"
      ],
      "severity": "MEDIUM",
      "category": "security",
      "confidence": "MEDIUM",
      "mode": "document",
      "exclude_comments": true,
      "when": [
        {
          "regex": "\\bCipher\\s*\\.\\s*getInstance\\s*\\(\\s*[\\\"\\'](?:AES|DES|DESede)/ECB/"
        }
