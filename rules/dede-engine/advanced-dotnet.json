    {
      "id": "dede.dotnet.crypto.broken-algorithm",
      "message": "Crypto broken algorithm requires security review.",
      "languages": [
        "c#",
        "visual basic",
        "f#",
        "razor"
      ],
      "severity": "MEDIUM",
      "category": "security",
      "confidence": "MEDIUM",
      "mode": "document",
      "exclude_comments": true,
      "when": [
        {
          "regex": "(?i)\\b(?:(?:MD5|DES|RC2)\\s*\\.\\s*Create|new\\s+(?:MD5CryptoServiceProvider|DESCryptoServiceProvider|RC2CryptoServiceProvider))\\s*\\("
        }
      ],
      "cwe": [
        "CWE-327"
      ],
      "owasp": [
        "A04:2025"
      ],
      "recommendation": "Use SHA-256 or stronger for integrity and authenticated encryption for confidentiality; use a password-specific KDF for passwords.",
      "references": [
        "https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/quality-rules/ca5351"
      ],
      "standards": {
        "microsoft-dotnet": [
          "CA5351"
        ]
      }
    },
