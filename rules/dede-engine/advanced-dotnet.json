    {
      "id": "dede.dotnet.deserialization.losformatter",
      "message": "Deserialization losformatter requires security review.",
      "languages": [
        "c#",
        "visual basic",
        "f#",
        "razor"
      ],
      "severity": "HIGH",
      "category": "security",
      "confidence": "MEDIUM",
      "mode": "document",
      "exclude_comments": true,
      "when": [
        {
          "regex": "(?i)\\b(?:new|New)\\s+(?:[\\w]+\\.)*LosFormatter\\s*\\("
        }
      ],
      "cwe": [
        "CWE-502"
      ],
      "owasp": [
        "A08:2025"
      ],
      "recommendation": "Replace this object-graph deserializer with a schema-bound format such as System.Text.Json; never deserialize attacker-controlled object graphs.",
      "references": [
        "https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/quality-rules/ca2305"
      ],
      "standards": {
        "microsoft-dotnet": [
          "CA2305"
        ]
      }
    },
