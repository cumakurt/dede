      "exclude_comments": true,
      "when": [
        {
          "regex": "(?i)\\bDangerousAcceptAnyServerCertificateValidator\\b"
        }
      ],
      "cwe": [
        "CWE-295"
      ],
      "owasp": [
        "A04:2025"
      ],
      "recommendation": "Use platform certificate chain and hostname validation; trust development certificates explicitly instead of accepting all certificates.",
      "references": [
        "https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/quality-rules/ca5359"
      ],
      "standards": {
        "microsoft-dotnet": [
