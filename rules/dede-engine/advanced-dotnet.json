    {
      "id": "dede.dotnet.tls.callback-always-true",
      "message": "Tls callback always true requires security review.",
      "languages": [
        "c#",
        "visual basic",
        "f#",
        "razor"
      ],
      "severity": "HIGH",
      "category": "security",
      "confidence": "MEDIUM",
      "mode": "document",
      "exclude_comments": true,
      "when": [
        {
          "regex": "(?i)\\b(?:ServerCertificateValidationCallback|ServerCertificateCustomValidationCallback|RemoteCertificateValidationCallback)\\s*(?:\\+?=|<-)\\s*(?:\\([^;{}]*?\\)\\s*=>\\s*(?:true\\b|\\{\\s*return\\s+true\\s*;)|Function\\s*\\([^\\n]*\\)\\s*True\\b|\\(?\\s*fun\\b[^;\\n]*->\\s*true\\b)"
        }
      ],
      "cwe": [
        "CWE-295"
      ],
      "owasp": [
        "A04:2025"
      ],
      "recommendation": "Preserve certificate-chain and hostname checks; a callback must reject validation errors.",
      "references": [
        "https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/quality-rules/ca5359"
      ],
      "standards": {
        "microsoft-dotnet": [
          "CA5359"
        ]
      }
    },
