    {
      "id": "dede.py.web.open-redirect",
      "message": "HTTP redirect destination built from user-supplied input; open redirect risk.",
      "severity": "MEDIUM",
      "category": "security",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "(?i)(redirect|make_response|HttpResponseRedirect|abort)\\s*\\(",
          "same_line": true
        },
        {
          "regex": "(?i)(request\\.(args|form|values|get_json|json|data|params|query_params|POST|GET))",
          "same_line": true,
          "not_regex": "(?i)(?:urlparse|url_for|allowed_hosts|safe_url|is_safe_url|\\#\\ dede:\\ validated)"
        }
