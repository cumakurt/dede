{
  "schema": 1,
  "rules": [
    {
      "id": "dede.py.auth.jwt-none-algorithm",
      "message": "JWT decoded with algorithm='none'; signature verification is completely bypassed.",
      "severity": "CRITICAL",
      "category": "security",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "(?i)(jwt\\.decode|jwt\\.decode_complete)\\s*\\(",
          "same_line": true
        },
        {
          "regex": "(?i)algorithm[s]?\\s*=\\s*['\"]none['\"]|algorithm[s]?\\s*=\\s*\\[['\"]none['\"]\\]",
          "same_line": true
        }
      ],
      "confidence": "HIGH",
      "cwe": [
        "CWE-347"
      ],
      "owasp": [
        "A02:2025"
      ],
      "asvs": [
        "v5.0.0-3.5.1"
      ],
      "recommendation": "Always specify an explicit signing algorithm (e.g. HS256, RS256) and never accept 'none'.",
      "references": [
        "https://cwe.mitre.org/data/definitions/347.html",
        "https://auth0.com/blog/critical-vulnerabilities-in-json-web-token-libraries/"
      ],
      "exclude_comments": true
    },
    {
      "id": "dede.py.auth.jwt-no-verify",
      "message": "JWT decoded with verify=False or options disabling signature/expiration check.",
      "severity": "CRITICAL",
      "category": "security",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "(?i)jwt\\.decode\\s*\\(",
          "same_line": true
        }
      ],
      "if": [
        {
          "contains_any": [
            "verify=false",
            "\"verify_signature\": false",
            "'verify_signature': false",
            "verify_exp\": false",
            "verify_exp': false"
          ]
        }
      ],
      "confidence": "HIGH",
      "cwe": [
        "CWE-347"
      ],
      "owasp": [
        "A02:2025"
      ],
      "asvs": [
        "v5.0.0-3.5.1"
      ],
      "recommendation": "Never disable JWT signature or expiration verification in production code.",
      "references": [
        "https://cwe.mitre.org/data/definitions/347.html"
      ],
      "exclude_comments": true
    },
    {
      "id": "dede.py.auth.hardcoded-jwt-secret",
      "message": "JWT signed with a short or hardcoded secret literal; tokens are forgeable.",
      "severity": "CRITICAL",
      "category": "secret",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "(?i)jwt\\.encode\\s*\\(",
          "same_line": true,
          "not_regex": "(?i)(?:os\\.environ|getenv|settings\\.|config\\.|secrets\\.token)"
        }
      ],
      "if": [
        {
          "contains_any": [
            "\"secret\"",
            "'secret'",
            "\"password\"",
            "'password'",
            "\"changeme\"",
            "'changeme'"
          ]
        }
      ],
      "confidence": "MEDIUM",
      "cwe": [
        "CWE-321"
      ],
      "owasp": [
        "A02:2025"
      ],
      "asvs": [
        "v5.0.0-3.5.2"
      ],
      "recommendation": "Load JWT secrets from environment variables or a secret manager; use at least 256-bit random values.",
      "references": [
        "https://cwe.mitre.org/data/definitions/321.html"
      ]
    },
    {
      "id": "dede.py.crypto.rsa-small-key",
      "message": "RSA key generated with fewer than 2048 bits; key is too small for security.",
      "severity": "HIGH",
      "category": "security",
      "languages": [
        "python"
      ],
      "when": [
        {
          "regex": "(?i)(rsa\\.generate_private_key|RSA\\.generate|generate_private_key)\\s*\\(",
          "same_line": true
        },
        {
          "regex": "\\b(512|768|1024)\\b",
          "same_line": true
        }
      ],
      "confidence": "HIGH",
      "cwe": [
        "CWE-326"
      ],
      "owasp": [
        "A02:2025"
      ],
      "asvs": [
        "v5.0.0-6.2.4"
      ],
      "recommendation": "Use RSA keys of at least 2048 bits; prefer 4096-bit for long-lived keys or use ECDSA P-256/P-384.",
      "references": [
        "https://cwe.mitre.org/data/definitions/326.html",
        "https://csrc.nist.gov/publications/detail/sp/800-57-part-1/rev-5/final"
      ],
      "exclude_comments": true
    },
    {
