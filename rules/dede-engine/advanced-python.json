      "cwe": [
        "CWE-327"
      ],
      "owasp": [
        "A02:2025"
      ],
      "asvs": [
        "v5.0.0-6.2.1"
      ],
      "recommendation": "Use AES-GCM or AES-CBC with a random IV; never ECB.",
      "references": [
        "https://cwe.mitre.org/data/definitions/327.html"
      ],
      "exclude_comments": true
    },
