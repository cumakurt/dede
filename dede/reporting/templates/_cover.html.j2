<section class="cover" id="cover">
  {% if has_logo %}
  <img class="cover-logo" src="{% if pdf %}{{ logo_src }}{% else %}{{ logo_data_uri }}{% endif %}" alt="Dede"/>
  {% else %}
  <p class="cover-eyebrow">Static Source Code Analysis</p>
  <p class="cover-brand">dede</p>
  {% endif %}
  <h1 class="cover-title">Application Security Analysis Report</h1>
  <p class="cover-lead">
    A decision-ready security report for engineering teams, AppSec specialists and executive stakeholders.
  </p>

  <table class="cover-meta" role="presentation">
    <tr><th>Project</th><td>{{ project_name }}</td></tr>
    <tr><th>Repository</th><td class="break-text">{{ repository }}</td></tr>
    <tr><th>Branch / Commit</th><td>{{ branch_commit_display }}</td></tr>
    <tr><th>Analysis Date</th><td>{{ analysis_date }}</td></tr>
    <tr><th>Analysis ID</th><td>{{ analysis_id }}</td></tr>
    <tr><th>Engine</th><td>{{ engine_label }}</td></tr>
  </table>

  <p class="cover-footer">
    Confidential — Generated by Dede / Static Source Code Analysis<br/>
    <span class="dev-line">Developed by {{ developer_name }} · <a href="mailto:{{ developer_email }}">{{ developer_email }}</a> · <a href="{{ developer_linkedin }}">LinkedIn</a> · <a href="{{ developer_github }}">GitHub</a></span>
  </p>
</section>
