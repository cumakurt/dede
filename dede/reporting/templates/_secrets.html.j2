{% if has_secrets %}
{% from "_macros.html.j2" import page_chrome with context %}
{{ page_chrome('Secrets & Credentials') }}
<section class="section" id="secrets">
  <p class="section-kicker">Secrets &amp; Credentials</p>
  <h2>Credential exposure</h2>
  <div class="callout warn">
    <strong>Secret values remain masked.</strong>
    The report displays only enough characters to support triage. Full credentials must never be reproduced in exported reports or logs.
  </div>
  <table class="data">
    <thead>
      <tr>
        <th>Secret Type</th>
        <th>File</th>
        <th>Line</th>
        <th>Exposure Risk</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for view in secrets_findings %}
      <tr>
        <td>{{ view.finding.rule_id }}</td>
        <td class="mono">{{ view.finding.file }}</td>
        <td>{{ view.finding.start_line }}</td>
        <td><span class="badge {{ view.finding.severity.value }}">{{ view.finding.severity.value }}</span></td>
        <td>{{ view.status }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endif %}
